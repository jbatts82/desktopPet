<?xml version="1.0" encoding="utf-8"?>
<animations xmlns:xsd="https://esheep.petrucci.ch/ https://raw.githubusercontent.com/Adrianotiger/desktopPet/master/Resources/animations.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://esheep.petrucci.ch/">
  <header>
    <author>KillerSlime</author>
    <title>MarioScreenPet</title>
    <petname>Big Mario</petname>
    <version>0.1</version>
    <info>Big Mario</info>
    <application>1</application>
    <icon><![CDATA[]]></icon>
  </header>
  <image>
    <tilesx>14</tilesx>
    <tilesy>3</tilesy>
    <png><![CDATA[]]></png>
    <transparency>transparent</transparency>
  </image>
  <spawns>
    <spawn id="1" probability="100">
      <x>screenW+10</x>
      <y>areaH-imageH</y>
      <next probability="100">1</next>
    </spawn>
  </spawns>
  <animations>
    <animation id="1">
      <name>walk_left</name>
      <start>
        <x>-11</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </start>
      <end>
        <x>-11</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </end>
      <sequence repeatfrom="0" repeat="random*3+200">
        <frame>8</frame>
        <frame>9</frame>
        <frame>10</frame>
        <next probability="100" only="none">1</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="none">2</next>
      </border>
    </animation>
    <animation id="2">
      <name>walk_right</name>
      <start>
        <x>11</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </start>
      <end>
        <x>11</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </end>
      <sequence repeatfrom="0" repeat="random*3+200">
        <frame>1</frame>
        <frame>2</frame>
        <frame>3</frame>
        <next probability="100" only="none">2</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="none">1</next>
      </border>
    </animation>
    <animation id="5">
      <name>fall</name>
      <start>
        <x>0</x>
        <y>4</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </start>
      <end>
        <x>0</x>
        <y>4</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </end>
      <sequence repeatfrom="0" repeat="0">
        <frame>15</frame>
        <next probability="100" only="none">1</next>
        <action>none</action>
      </sequence>
    </animation>
    <animation id="6">
      <name>sync</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </end>
      <sequence repeatfrom="0" repeat="0">
        <frame>0</frame>
        <next probability="100" only="none">1</next>
        <action>none</action>
      </sequence>
    </animation>
    <animation id="7">
      <name>drag</name>
      <start>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </start>
      <end>
        <x>0</x>
        <y>0</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </end>
      <sequence repeatfrom="0" repeat="0">
        <frame>28</frame>
        <next probability="100" only="none">2</next>
        <action>none</action>
      </sequence>
    </animation>
    <animation id="8">
      <name>kill</name>
      <start>
        <x>0</x>
        <y>4</y>
        <offsety>0</offsety>
        <opacity>1</opacity>
        <interval>110</interval>
      </start>
      <end>
        <x>0</x>
        <y>4</y>
        <offsety>0</offsety>
        <opacity>0</opacity>
        <interval>110</interval>
      </end>
      <sequence repeatfrom="0" repeat="5">
        <frame>0</frame>
        <action>none</action>
      </sequence>
    </animation>
  </animations>
  <childs />
</animations>