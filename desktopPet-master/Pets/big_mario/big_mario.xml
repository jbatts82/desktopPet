    <animation id="15">
      <name>skid_R_to_L</name>
      <start><x>25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="11">
        <frame>11</frame>
        <next probability="100" only="none">1</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">17</next>
      </border>
      <gravity>
        <next probability="100" only="none">24</next>
      </gravity>
    </animation>

    <!-- 16: skid LEFT->RIGHT - sliding left, facing right (frame 4) -->
    <animation id="16">
      <name>skid_L_to_R</name>
      <start><x>-25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="11">
