  <!--
    ============================================================================
    MOVEMENT TUNED TO THE ORIGINAL SUPER MARIO BROS. (NES) PHYSICS
    Constants taken from the SMB 6502 disassembly. See ../../../SMB1_PHYSICS.md
    ============================================================================

    Sprite scale: the 16x32 NES "big Mario" is drawn at 80x160 here, so S = 5.
    NES frame = 16.64 ms. eSheep moves <x>/<y> pixels once per <interval> ms,
    so with T = NES frames per tick:

        interval = T * 16.64          x = v_nes_px_per_frame * S * T

    SMB1 holds each sprite frame for T = 2 (running), 4 (walking) or 7 (creeping)
    NES frames (PlayerAnimTmrData), so one eSheep tick == one sprite frame:

        walk    v=1.5 px/f  T=4  ->  interval 67   x=30   (270 px/s)
        run     v=2.5 px/f  T=2  ->  interval 33   x=25   (450 px/s)
        in air (walk speed)  T=2  ->  interval 33   x=15

    Jumps: initial vy and gravity are chosen at takeoff from horizontal speed.
    Rising with A held is weak gravity, descending is ~3.5x stronger - so rise
    and fall are separate animations. eSheep interpolates <y> linearly from
    start to end, which IS constant acceleration.

        walk jump  vy=-4.0 g=0.1250  ->  y -40..0 over 16 steps  (apex 320 px)
        run  jump  vy=-5.0 g=0.1563  ->  y -50..0 over 16 steps  (apex 400 px)
        fall       g=0.4375, terminal 4.0 px/f -> y 0..40 over 5 steps, then y=40

    Skid: holding back doubles friction; a full-speed skid bleeds 2.5 px/f to 0
    in ~23 NES frames (~0.4 s, ~30 NES px) and Mario faces the NEW direction
    while still sliding the old way. That is animations 15/16.

    Frame map (sheet row 0; row 2 is an identical copy):
        0 stand R | 1,2,3 walk R | 4 skid R | 5 jump R | 6 crouch R
        7 stand L | 8,9,10 walk L | 11 skid L | 12 jump L | 13 crouch L

    Animation IDs:
        1/2   walk_left / walk_right          9/10   accel_left / accel_right
        3/4   idle_left / idle_right          11/12  run_left / run_right
        5     fall (drag release)             13/14  runup_left / runup_right
        6     sync                            15/16  skid_R_to_L / skid_L_to_R
        7     drag                            17/18  turn_R_to_L / turn_L_to_R (wall)
        8     kill                            19/20  jump_left / jump_right
        31    fall_fast (drag release)        21/22  jump_run_left / jump_run_right
                                              23..26 fall_* / fall_*_fast (walk speed)
                                              27..30 fall_run_* / fall_run_*_fast

    ============================================================================
    EDGE / WINDOW DETECTION - read this before touching any <border>
    ============================================================================

    only= is a BITMASK, and only="none" is 0x7F: a WILDCARD that matches EVERY
    border event, not "no border". (Animations.cs: `if (anim.only != NONE &&
    (anim.only & where) == 0) continue;`) A <next only="none"> inside <border>
    therefore fires for screen edges, window edges, the taskbar and the ceiling
    alike. Specific only= entries ADD weighted options alongside that baseline.

    The runtime raises a TYPED event depending on what was hit (FormPet.cs):
        screen left/right edge ....... vertical
        WINDOW left/right edge ....... window
        screen bottom / taskbar ...... taskbar
        top of a window (falling) .... window
        screen ceiling (moving up) ... horizontal

    Walking off a ledge is expressed by ABSENCE, not by an animation: if a
    <border> has no entry matching `window`, the lookup returns -1 and the
    runtime clears hwndWindow ("not anymore on the window") WITHOUT zeroing x.
    Mario keeps striding, is now unsupported, and <gravity> catches him on the
    next tick. Hence the ground animations (1,2,9..16) match only="vertical"
    only: they turn around at real screen walls, and walk off window ledges.
    That is what their <gravity> edges are for - remove the vertical-only and
    those edges go dead and Mario paces on top of a window forever.

    Two consequences worth preserving:
      - the fall_* <border>s keep only="none" ON PURPOSE: it is what catches
        BOTH landing on the taskbar and landing on top of a window.
      - an animation landed into must have start <y>0</y>, or FormPet.cs:603
        clears hwndWindow and Mario immediately drops through the window.
  -->
  <spawns>
    <spawn id="1" probability="50">
      <x>10</x>
      <y>areaH-imageH</y>
      <next probability="100">10</next>
    </spawn>
    <spawn id="2" probability="50">
      <x>screenW-imageW-10</x>
      <y>areaH-imageH</y>
      <next probability="100">9</next>
    </spawn>
  </spawns>
  <animations>

    <!-- 1: walk LEFT - 1.5 px/f, 4 NES frames per sprite frame -->
    <animation id="1">
      <name>walk_left</name>
      <start><x>-30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></start>
      <end><x>-30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></end>
      <sequence repeatfrom="0" repeat="random/12+6">
        <frame>8</frame>
        <frame>9</frame>
        <frame>10</frame>
        <next probability="45" only="none">1</next>
        <next probability="30" only="none">13</next>
        <next probability="15" only="none">3</next>
        <next probability="10" only="none">19</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">18</next>
      </border>
      <gravity>
        <next probability="100" only="none">23</next>
      </gravity>
    </animation>

    <!-- 2: walk RIGHT -->
    <animation id="2">
      <name>walk_right</name>
      <start><x>30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></start>
      <end><x>30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></end>
      <sequence repeatfrom="0" repeat="random/12+6">
        <frame>1</frame>
        <frame>2</frame>
        <frame>3</frame>
        <next probability="45" only="none">2</next>
        <next probability="30" only="none">14</next>
        <next probability="15" only="none">4</next>
        <next probability="10" only="none">20</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">17</next>
      </border>
      <gravity>
        <next probability="100" only="none">24</next>
      </gravity>
    </animation>

    <!-- 3: idle LEFT -->
    <animation id="3">
      <name>idle_left</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>400</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>400</interval></end>
      <sequence repeatfrom="0" repeat="random/25+2">
        <frame>7</frame>
        <next probability="65" only="none">9</next>
        <next probability="35" only="none">18</next>
        <action>none</action>
      </sequence>
      <gravity>
        <next probability="100" only="none">5</next>
      </gravity>
    </animation>

    <!-- 4: idle RIGHT -->
    <animation id="4">
      <name>idle_right</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>400</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>400</interval></end>
      <sequence repeatfrom="0" repeat="random/25+2">
        <frame>0</frame>
        <next probability="65" only="none">10</next>
        <next probability="35" only="none">17</next>
        <action>none</action>
      </sequence>
      <gravity>
        <next probability="100" only="none">5</next>
      </gravity>
    </animation>

    <!-- 5: fall - bound by name, used when the user drops Mario after dragging.
         g = 0.4375 px/f^2 -> 8.75 px/tick^2, terminal 4.0 px/f -> 40 px/tick. -->
    <animation id="5">
      <name>fall</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>0</x><y>40</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="4">
        <frame>5</frame>
        <next probability="100" only="none">31</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="none">4</next>
      </border>
    </animation>

    <!-- 6: sync -->
    <animation id="6">
      <name>sync</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>400</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>400</interval></end>
      <sequence repeatfrom="0" repeat="2">
        <frame>0</frame>
        <next probability="100" only="none">4</next>
        <action>none</action>
      </sequence>
    </animation>

    <!-- 7: drag - held by the mouse, jump pose -->
    <animation id="7">
      <name>drag</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></end>
      <sequence repeatfrom="0" repeat="0">
        <frame>5</frame>
        <next probability="100" only="none">7</next>
        <action>none</action>
      </sequence>
    </animation>

    <!-- 8: kill - drop off the screen and fade -->
    <animation id="8">
      <name>kill</name>
      <start><x>0</x><y>20</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>0</x><y>40</y><offsety>0</offsety><opacity>0</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="30">
        <frame>5</frame>
        <action>none</action>
      </sequence>
    </animation>

    <!-- 9: accelerate LEFT from standstill - 0.0371 px/f^2, ~40 NES frames to
         reach walk speed. x ramps 0 -> -30 while the frame hold shortens 117 -> 67. -->
    <animation id="9">
      <name>accel_left</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>117</interval></start>
      <end><x>-30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></end>
      <sequence repeatfrom="0" repeat="2">
        <frame>8</frame>
        <frame>9</frame>
        <frame>10</frame>
        <next probability="100" only="none">1</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">18</next>
      </border>
      <gravity>
        <next probability="100" only="none">23</next>
      </gravity>
    </animation>

    <!-- 10: accelerate RIGHT from standstill -->
    <animation id="10">
      <name>accel_right</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>117</interval></start>
      <end><x>30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></end>
      <sequence repeatfrom="0" repeat="2">
        <frame>1</frame>
        <frame>2</frame>
        <frame>3</frame>
        <next probability="100" only="none">2</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">17</next>
      </border>
      <gravity>
        <next probability="100" only="none">24</next>
      </gravity>
    </animation>

    <!-- 11: run LEFT - 2.5 px/f, 2 NES frames per sprite frame (same 3-frame
         cycle as the walk; SMB1 has no separate run art, it just plays faster) -->
    <animation id="11">
      <name>run_left</name>
      <start><x>-25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>-25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="random/10+8">
        <frame>8</frame>
        <frame>9</frame>
        <frame>10</frame>
        <next probability="60" only="none">11</next>
        <next probability="15" only="none">21</next>
        <next probability="15" only="none">16</next>
        <next probability="10" only="none">1</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">18</next>
      </border>
      <gravity>
        <next probability="100" only="none">27</next>
      </gravity>
    </animation>

    <!-- 12: run RIGHT -->
    <animation id="12">
      <name>run_right</name>
      <start><x>25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="random/10+8">
        <frame>1</frame>
        <frame>2</frame>
        <frame>3</frame>
        <next probability="60" only="none">12</next>
        <next probability="15" only="none">22</next>
        <next probability="15" only="none">15</next>
        <next probability="10" only="none">2</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">17</next>
      </border>
      <gravity>
        <next probability="100" only="none">28</next>
      </gravity>
    </animation>

    <!-- 13: walk -> run LEFT - 0.0557 px/f^2, ~18 NES frames from 1.5 to 2.5 px/f -->
    <animation id="13">
      <name>runup_left</name>
      <start><x>-30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></start>
      <end><x>-25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="1">
        <frame>8</frame>
        <frame>9</frame>
        <frame>10</frame>
        <next probability="100" only="none">11</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">18</next>
      </border>
      <gravity>
        <next probability="100" only="none">27</next>
      </gravity>
    </animation>

    <!-- 14: walk -> run RIGHT -->
    <animation id="14">
      <name>runup_right</name>
      <start><x>30</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>67</interval></start>
      <end><x>25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="1">
        <frame>1</frame>
        <frame>2</frame>
        <frame>3</frame>
        <next probability="100" only="none">12</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">17</next>
      </border>
      <gravity>
        <next probability="100" only="none">28</next>
      </gravity>
    </animation>

    <!-- 15: skid RIGHT->LEFT - still sliding right (x 25 -> 0) but already facing
         left (frame 11), exactly like holding back out of a run in SMB1 -->
    <animation id="15">
      <name>skid_R_to_L</name>
      <start><x>25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="11">
        <frame>11</frame>
        <next probability="100" only="none">1</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">17</next>
      </border>
      <gravity>
        <next probability="100" only="none">24</next>
      </gravity>
    </animation>

    <!-- 16: skid LEFT->RIGHT - sliding left, facing right (frame 4) -->
    <animation id="16">
      <name>skid_L_to_R</name>
      <start><x>-25</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="11">
        <frame>4</frame>
        <next probability="100" only="none">2</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="vertical">18</next>
      </border>
      <gravity>
        <next probability="100" only="none">23</next>
      </gravity>
    </animation>

    <!-- 17: turn at a wall, RIGHT->LEFT. Running into a wall zeroes Mario's speed
         in SMB1, so this one does not move (x=0) - which also stops the border
         trigger from firing again on the next tick. -->
    <animation id="17">
      <name>turn_R_to_L</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>60</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>60</interval></end>
      <sequence repeatfrom="0" repeat="0">
        <frame>11</frame>
        <frame>11</frame>
        <frame>7</frame>
        <next probability="100" only="none">9</next>
        <action>none</action>
      </sequence>
    </animation>

    <!-- 18: turn at a wall, LEFT->RIGHT -->
    <animation id="18">
      <name>turn_L_to_R</name>
      <start><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>60</interval></start>
      <end><x>0</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>60</interval></end>
      <sequence repeatfrom="0" repeat="0">
        <frame>4</frame>
        <frame>4</frame>
        <frame>0</frame>
        <next probability="100" only="none">10</next>
        <action>none</action>
      </sequence>
    </animation>

    <!-- 19: jump LEFT at walk speed - vy 4.0 px/f, gravity 0.125 while rising.
         Rise takes 32 NES frames = 16 ticks and peaks 64 NES px (320 px) up. -->
    <animation id="19">
      <name>jump_left</name>
      <start><x>-15</x><y>-40</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></start>
      <end><x>-15</x><y>0</y><offsety>0</offsety><opacity>1</opacity><interval>33</interval></end>
      <sequence repeatfrom="0" repeat="15">
        <frame>12</frame>
        <next probability="100" only="none">23</next>
        <action>none</action>
      </sequence>
      <border>
        <next probability="100" only="none">23</next>
